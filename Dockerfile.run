FROM python:3.14-slim-bookworm
ARG SOLAR_FORGE_DESKTOP_UID=1000
ARG SOLAR_FORGE_DESKTOP_GID=1000
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends \
    libegl1 libgl1 libxkbcommon0 libdbus-1-3 libglib2.0-0 libfontconfig1 \
    libwayland-cursor0 fonts-noto-color-emoji \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /desktop
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --frozen --no-dev
RUN mkdir -p /data /config /backups && chown "${SOLAR_FORGE_DESKTOP_UID}:${SOLAR_FORGE_DESKTOP_GID}" /data /config /backups
VOLUME ["/data", "/config", "/backups"]
USER ${SOLAR_FORGE_DESKTOP_UID}:${SOLAR_FORGE_DESKTOP_GID}
CMD ["/desktop/.venv/bin/solar-forge-desktop"]
